    "lint:oxlint": "oxlint . --fix",
    "lint:oxlint:ci": "oxlint .",
    "lint:eslint": "eslint . --fix --cache",
    "lint:eslint:ci": "eslint . --cache",
    "format": "oxfmt src/",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:ci": "tauri build --no-bundle -c src-tauri/tauri.ci.conf.json"
  },
  "dependencies": {
    "@lucide/vue": "^1.16.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/vue-table": "^8.21.3",
